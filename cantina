    // Se muestran por separado para que la caja sea fácil de entender.
    const totalCompras = totalComprasPagadas;


    const totalGastos =
    gastos.reduce(
        (s,g)=>s+g.monto,
        0
    );


    const costo =
    ventas.reduce(
        (s,v)=>s+v.costoTotal,
        0
    );


    const ganancia =
    totalVentas -
    costo -
    totalGastos;


    const ventasEfectivo =
    ventas
    .filter(v => (v.metodoPago || "efectivo") === "efectivo")
    .reduce((s,v)=>s+v.total,0);

    const ventasTransferencia =
    ventas
    .filter(v => (v.metodoPago || "efectivo") === "transferencia")
    .reduce((s,v)=>s+v.total,0);

    const totalCambios =
    movimientos.reduce((s,m)=>s+m.monto,0);

    const caja =
    cajaInicial +
    ventasEfectivo -
    totalCompras -
    pagosCreditoHoy -
    totalGastos -
    totalCambios;


    document.getElementById(
        "totalVentas"
    ).textContent=
    "$"+totalVentas.toFixed(2);


    document.getElementById(
        "totalVentasEfectivo"
    ).textContent=
    "$"+ventasEfectivo.toFixed(2);

    document.getElementById(
        "totalVentasTransferencia"
    ).textContent=
    "$"+ventasTransferencia.toFixed(2);

    document.getElementById(
        "totalCambiosTransferencia"
    ).textContent=
    "$"+totalCambios.toFixed(2);

    document.getElementById(
        "totalCompras"
    ).textContent=
    "$"+totalCompras.toFixed(2);

    document.getElementById("totalPagosCredito").textContent=
    "$"+pagosCreditoHoy.toFixed(2);

    document.getElementById("totalCreditoPendiente").textContent=
    "$"+creditos.reduce((s,c)=>s+Number(c.saldo||0),0).toFixed(2);


    document.getElementById(
        "totalGastos"
    ).textContent=
    "$"+totalGastos.toFixed(2);


    document.getElementById(
        "costoVendido"
    ).textContent=
    "$"+costo.toFixed(2);


    document.getElementById("gananciaOperativa").textContent=
    "$"+ganancia.toFixed(2);

    document.getElementById(
        "ganancia"
    ).textContent=
    "$"+ganancia.toFixed(2);


    document.getElementById(
        "ganancia"
    ).className=
    ganancia>=0
    ? "ganancia"
    : "perdida";


    document.getElementById(
        "cajaInicial"
    ).textContent=
    "$"+cajaInicial.toFixed(2);


    document.getElementById(
        "dineroCaja"
    ).textContent=
    "$"+caja.toFixed(2);


    /* HISTORIAL */

    actualizarHistorial();
}


