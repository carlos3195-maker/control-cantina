   HISTORIAL
   ========================================================= */

function agregarReceta(){
    const nombre=document.getElementById("nombreReceta").value.trim();
    const ingredientes=document.getElementById("ingredientesReceta").value.trim();
    const costo=Number(document.getElementById("costoReceta").value)||0;
    if(!nombre || !ingredientes){ alert("Escribe el nombre y los ingredientes."); return; }
    recetas.unshift({id:Date.now(),nombre,ingredientes,costo});
    guardar(); actualizar();
    document.getElementById("nombreReceta").value="";
    document.getElementById("ingredientesReceta").value="";
    document.getElementById("costoReceta").value="";
}

function eliminarReceta(id){
    if(!confirm("¿Eliminar esta receta?")) return;
    recetas=recetas.filter(r=>r.id!==id); guardar(); actualizar();
}

function renderProductosHistorial(productosVendidos){
    if(!productosVendidos || Object.keys(productosVendidos).length===0) return '<p class="aviso">Sin ventas de productos.</p>';
    return Object.values(productosVendidos).map(x=>`<div class="producto-resumen"><div class="producto-resumen-top"><span>${escapeHTML(x.nombre)}</span><span>${x.cantidad} und.</span></div><div class="producto-resumen-detail">
Ventas: $${x.total.toFixed(2)} · Costo: $${Number(x.costo || 0).toFixed(2)}
<br>Ganancia: $${Number(x.ganancia || 0).toFixed(2)}
</div></div>`).join('');
}

function actualizarHistorial(){

    let html="";


    if(historial.length===0){

        html=
        "<p style='color:#888;text-align:center'>"+
        "Todavía no hay días cerrados"+
        "</p>";

    }else{

        historial.forEach(d=>{

            html+=`

            <div class="historial">

                <strong>📅 ${d.fecha}</strong>

                <hr style="margin:8px 0;border:none;border-top:1px solid #ddd">

                <p>💰 Ventas:
                $${d.ventas.toFixed(2)}</p>

                <p>💵 Efectivo de ventas:
                $${(d.ventasEfectivo || 0).toFixed(2)}</p>

                <p>📲 Transferencias de ventas:
                $${(d.ventasTransferencia || 0).toFixed(2)}</p>

                <div class="resumen-bloque">
                    <strong>🍺 Productos vendidos</strong>
                    ${renderProductosHistorial(d.productosVendidos)}
                </div>

                <p>🔄 Cambios de efectivo:
                $${(d.cambiosTransferencia || 0).toFixed(2)}</p>

                <p>🛒 Compras pagadas:
                $${d.compras.toFixed(2)}</p>

                <p>🧾 Créditos pagados ese día:
                $${Number(d.pagosCredito || 0).toFixed(2)}</p>

                <p>🔴 Crédito pendiente al cierre:
                $${Number(d.creditoPendiente || 0).toFixed(2)}</p>
                ${d.creditosPendientes && d.creditosPendientes.length ? `<div class="resumen-bloque"><strong>🧾 Deudas pendientes</strong>${d.creditosPendientes.map(c=>`<p style="margin:6px 0">${escapeHTML(c.nombre)} · ${escapeHTML(c.proveedor)} · <strong>$${Number(c.saldo||0).toFixed(2)}</strong></p>`).join('')}</div>` : ''}

                <p>💸 Gastos:
                $${d.gastos.toFixed(2)}</p>

                <p>📦 Costo vendido:
                $${d.costo.toFixed(2)}</p>

                <p>
                <strong>
                ✅ Ganancia:
                $${d.ganancia.toFixed(2)}
                </strong>
                </p>

                <p>
                💵 Caja final:
                $${d.cajaFinal.toFixed(2)}
                </p>

            </div>

            `;

        });

    }


    document.getElementById(
        "listaHistorial"
    ).innerHTML=html;
}


/* =========================================================
   SEGURIDAD
   ========================================================= */

function escapeHTML(text){

    return String(text)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


