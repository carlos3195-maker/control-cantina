/* =========================================================
   NUEVO DÍA
   ========================================================= */

function nuevoDia(){

    const totalVentas =
    ventas.reduce(
        (s,v)=>s+v.total,
        0
    );


    const totalComprasPagadas =
    compras.reduce((s,c)=>s+Number(c.total||0),0);

    const pagosCreditoHoy = totalPagosCreditoHoy();

    // Se muestran por separado para que la caja sea fácil de entender.
    const totalCompras = totalComprasPagadas;


    const totalGastos =
    gastos.reduce(
        (s,g)=>s+g.monto,
        0
    );


    const costo =
    ventas.reduce(
        (s,v)=>s+v.costoTotal,
        0
    );


    const ganancia =
    totalVentas -
    costo -
    totalGastos;


    const ventasEfectivo =
    ventas
    .filter(v => (v.metodoPago || "efectivo") === "efectivo")
    .reduce((s,v)=>s+v.total,0);

    const totalCambios =
    movimientos.reduce((s,m)=>s+m.monto,0);

    const cajaFinal =
    cajaInicial +
    ventasEfectivo -
    totalCompras -
    pagosCreditoHoy -
    totalGastos -
    totalCambios;


    if(!confirm(

        "🔒 CERRAR DÍA\n\n"+

        "Ventas: $"+
        totalVentas.toFixed(2)+
        "\nCompras: $"+
        totalCompras.toFixed(2)+
        "\nGastos: $"+
        totalGastos.toFixed(2)+
        "\nGanancia: $"+
        ganancia.toFixed(2)+
        "\nCaja esperada: $"+
        cajaFinal.toFixed(2)+

        "\n\n📦 EL INVENTARIO NO SE MODIFICARÁ."+

        "\n\n¿Quieres cerrar el día?"

    ))return;


    /*
       GUARDAMOS SOLAMENTE EL RESUMEN.

       OBSERVA QUE AQUÍ NO HACEMOS:

       productos = []
       NI
       productos.stock = stockInicial

       NI
       productos.stock += ventas

       NI
       productos.stock = ...

       EL INVENTARIO QUEDA EXACTAMENTE
       COMO ESTÁ EN ESTE MOMENTO.
    */

    historial.unshift({

        id:Date.now(),

        fecha:fechaActual(),

        ventas:totalVentas,

        compras:totalCompras,

        gastos:totalGastos,

        costo:costo,

        ganancia:ganancia,

        cajaInicial:cajaInicial,

        ventasEfectivo:ventasEfectivo,

        ventasTransferencia:ventas
        .filter(v => (v.metodoPago || "efectivo") === "transferencia")
        .reduce((s,v)=>s+v.total,0),

        cambiosTransferencia:totalCambios,

        pagosCredito:pagosCreditoHoy,
        creditoPendiente:creditos.reduce((s,c)=>s+Number(c.saldo||0),0),
        creditosPendientes: creditos.filter(c=>Number(c.saldo||0)>0).map(c=>({proveedor:c.proveedor,nombre:c.nombre,saldo:Number(c.saldo||0)})),

        productosVendidos: ventas.reduce((acc,v)=>{
            const key=v.productoId || v.nombre;
            if(!acc[key]) acc[key]={nombre:v.nombre,cantidad:0,total:0,costo:0,ganancia:0};
            acc[key].cantidad += v.cantidad;
            acc[key].total += v.total;
            acc[key].costo += Number(v.costoTotal || 0);
            acc[key].ganancia += Number(v.total || 0) - Number(v.costoTotal || 0);
            return acc;
        },{}),

        cajaFinal:cajaFinal

    });


    /*
       SOLAMENTE SE LIMPIAN LOS MOVIMIENTOS
       DEL DÍA.
    */

    ventas=[];
    compras=[];
    gastos=[];
    movimientos=[];

    cajaInicial=0;


    /*
       MUY IMPORTANTE:

       productos NO SE MODIFICA.
    */


    guardar();
    actualizar();


    alert(
        "✅ DÍA CERRADO.\n\n"+
        "📦 Inventario conservado.\n"+
        "📚 Resumen guardado en historial.\n\n"+
        "El nuevo día comienza con exactamente "+
        "el inventario que quedó."
    );
}


