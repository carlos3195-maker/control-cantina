<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Control de Cantina — v4</title>

<style>
*{box-sizing:border-box;font-family:Arial,sans-serif;margin:0;padding:0}

body{
    background:#f5f5f5;
    padding:15px;
    max-width:480px;
    margin:auto
}

h1{text-align:center;color:#333;margin-bottom:15px;font-size:22px}
h2{font-size:18px;color:#444;margin:15px 0 10px}
h3{font-size:15px;color:#555;margin:12px 0 6px}

.card{
    background:white;
    border-radius:10px;
    padding:15px;
    margin-bottom:15px;
    box-shadow:0 2px 5px rgba(0,0,0,.1)
}

input,button,select,textarea{
    width:100%;
    padding:12px;
    margin:6px 0;
    border-radius:6px;
    border:1px solid #ddd;
    font-size:15px
}

button{
    background:#2563eb;
    color:white;
    border:none;
    cursor:pointer;
    font-weight:bold
}

button:hover{background:#1d4ed8}

button.danger{background:#dc2626}
button.danger:hover{background:#b91c1c}

button.small{
    width:auto;
    padding:6px 10px;
    font-size:13px
}

button.verde{background:#059669}
button.gris{background:#6b7280}

.tabs{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    margin-bottom:15px
}

.tab{
    flex:1;
    padding:11px 4px;
    background:#ddd;
    font-size:13px
}

.tab.active{
    background:#2563eb;
    color:white
}

.oculto{display:none!important}

.item{
    padding:12px 0;
    border-bottom:1px solid #eee;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px
}

.item:last-child{border-bottom:none}

.resumen{background:#fef3c7}

.divider{
    border-top:1px dashed #d6b84c;
    margin:15px 0
}

.efectivo{
    font-size:22px;
    font-weight:bold;
    color:#059669;
    background:#d1fae5;
    padding:12px;
    border-radius:8px;
    text-align:center;
    margin:10px 0
}

.ganancia{
    color:#16a34a;
    font-weight:bold
}

.perdida{
    color:#dc2626;
    font-weight:bold
}

.aviso{
    font-size:13px;
    color:#666;
    margin-top:7px
}

.fecha{
    text-align:center;
    background:#e0e7ff;
    padding:9px;
    border-radius:7px;
    margin-bottom:15px
}

.stock-bajo{
    color:#dc2626;
    font-weight:bold
}

.stock-ok{
    color:#16a34a;
    font-weight:bold
}

.historial{
    background:#f9fafb;
    border:1px solid #ddd;
    border-radius:8px;
    padding:12px;
    margin-bottom:10px
}

.resumen-bloque{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:8px;
    padding:10px;
    margin-top:8px
}

.dato,.dato-grande{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    padding:9px 0;
    border-bottom:1px solid #eee
}

.dato:last-child{border-bottom:none}

.dato-grande{
    font-size:17px;
    padding:12px 0
}

.dato-grande strong{
    font-size:20px
}

.destacado{
    background:#dcfce7;
    margin:5px -5px;
    padding:12px 8px;
    border-radius:8px;
    color:#166534;
    border-bottom:none
}

.producto-resumen{
    padding:9px 0;
    border-bottom:1px solid #eee
}

.producto-resumen:last-child{border-bottom:none}

.producto-resumen-top{
    display:flex;
    justify-content:space-between;
    gap:8px;
    font-weight:bold
}

.producto-resumen-detail{
    color:#555;
    font-size:13px;
    margin-top:4px
}
</style>
</head>

<body>

<h1>🍺 Control de Cantina</h1>

<div class="fecha">
📅 Día actual: <strong id="fecha"></strong>
</div>

<div class="tabs">
<button class="tab active" onclick="mostrar('productos',this)">Productos</button>
<button class="tab" onclick="mostrar('compras',this)">Compras</button>
<button class="tab" onclick="mostrar('ventas',this)">Ventas</button>
<button class="tab" onclick="mostrar('movimientos',this)">Caja / Cambios</button>
<button class="tab" onclick="mostrar('gastos',this)">Gastos</button>
<button class="tab" onclick="mostrar('resumen',this)">Resumen</button>
<button class="tab" onclick="mostrar('historial',this)">Historial</button>
<button class="tab" onclick="mostrar('recetas',this)">Recetas</button>
</div>


<!-- PRODUCTOS -->

<div id="productos">

<div class="card">

<h2>➕ Agregar Producto</h2>

<input id="nombre" type="text" placeholder="Nombre del producto">

<input id="costo" type="number" min="0" step="0.01"
placeholder="Costo de compra">

<input id="precio" type="number" min="0" step="0.01"
placeholder="Precio de venta">

<input id="stock" type="number" min="0" step="1"
placeholder="Inventario inicial">

<button onclick="agregarProducto()">
Agregar Producto
</button>

</div>


<div class="card">

<h2>📦 Inventario ACTUAL</h2>

<div id="inventario"></div>

<p class="aviso">
🔒 El inventario es permanente. Cerrar o comenzar un nuevo día
NO modifica las existencias.
</p>

</div>

</div>


<!-- COMPRAS -->

<div id="compras" class="oculto">

<div class="card">

<h2>🛒 Registrar Compra</h2>

<select id="productoCompra"></select>

<select id="tipoCompra" onchange="actualizarCamposCompra()">
<option value="unidad">📦 Compra por unidad</option>
<option value="caja">🗃️ Compra por caja</option>
</select>

<input id="proveedorCompra" type="text" placeholder="Proveedor (opcional)">

<select id="estadoCompra">
<option value="pagada">💵 Compra pagada</option>
<option value="credito">🧾 Compra a crédito</option>
</select>

<div id="compraUnidadCampos">
<input id="cantidadCompra"
type="number"
min="1"
step="1"
placeholder="Cantidad de unidades compradas">

<input id="costoCompraUnidad"
type="number"
min="0"
step="0.01"
placeholder="Costo por unidad (opcional)">
</div>

<div id="compraCajaCampos" class="oculto">
<input id="cantidadCajas"
type="number"
min="1"
step="1"
placeholder="Cantidad de cajas">

<input id="unidadesPorCaja"
type="number"
min="1"
step="1"
placeholder="Unidades que trae cada caja">

<input id="costoCaja"
type="number"
min="0"
step="0.01"
placeholder="Costo de cada caja">
</div>

<p id="detalleCompra" class="aviso"></p>

<button onclick="registrarCompra()">
Registrar Compra
</button>

</div>

<div class="card">

<h2>📋 Compras pagadas del día</h2>

<div id="listaCompras"></div>

</div>

<div class="card">

<h2>🧾 Créditos pendientes</h2>
<p class="aviso">Las compras a crédito entran al inventario inmediatamente. No descuentan caja hasta que registres el pago.</p>
<div id="listaCreditos"></div>

</div>

</div>


<!-- VENTAS -->

<div id="ventas" class="oculto">

<div class="card">

<h2>🍺 Registrar Venta</h2>

<select id="productoVenta"></select>

<input id="cantidadVenta"
type="number"
min="1"
step="1"
placeholder="Cantidad vendida">

<select id="metodoVenta">
<option value="efectivo">💵 Efectivo</option>
<option value="transferencia">📲 Transferencia</option>
</select>

<button onclick="registrarVenta()">
Registrar Venta
</button>

</div>

<div class="card">

<h2>📋 Ventas del día</h2>

<div id="listaVentas"></div>

</div>

</div>


<!-- MOVIMIENTOS DE CAJA -->

<div id="movimientos" class="oculto">

<div class="card">

<h2>🔄 Cambio de efectivo por transferencia</h2>

<p class="aviso">
No es una venta. La persona te transfiere dinero y tú le entregas
efectivo de la caja. Se registra por separado y NO aumenta las ventas.
</p>

<input id="montoCambio" type="number" min="0.01" step="0.01"
placeholder="Monto que entregarás en efectivo">

<input id="notaCambio" type="text"
placeholder="Nota (opcional)">

<button class="verde" onclick="registrarCambioEfectivo()">
Registrar cambio
</button>

</div>

<div class="card">

<h2>📋 Cambios de efectivo de hoy</h2>
<div id="listaMovimientos"></div>

</div>

</div>


<!-- GASTOS -->

<div id="gastos" class="oculto">

<div class="card">

<h2>💸 Registrar Gasto</h2>

<input id="descripcionGasto"
type="text"
placeholder="Descripción del gasto">

<input id="montoGasto"
type="number"
min="0"
step="0.01"
placeholder="Monto">

<button onclick="registrarGasto()">
Registrar Gasto
</button>

</div>

<div class="card">

<h2>📋 Gastos del día</h2>

<div id="listaGastos"></div>

</div>

</div>


<!-- RESUMEN -->

<div id="resumen" class="oculto">

<div class="card resumen">

<h2>📊 Resumen del Día</h2>

<div class="resumen-bloque">
<h3>🍺 Lo vendido por producto</h3>
<div id="resumenProductos"></div>
</div>

<div class="divider"></div>

<h3>💰 Dinero de las ventas</h3>
<div class="dato-grande">
<span>💰 Total vendido</span>
<strong id="totalVentas">$0.00</strong>
</div>
<div class="dato">
<span>💵 Efectivo</span>
<strong id="totalVentasEfectivo">$0.00</strong>
</div>
<div class="dato">
<span>📲 Transferencias de ventas</span>
<strong id="totalVentasTransferencia">$0.00</strong>
</div>

<div class="divider"></div>

<h3>💸 Salidas que afectan la caja</h3>
<div class="dato">
<span>🛒 Compras pagadas hoy</span>
<strong id="totalCompras">$0.00</strong>
</div>
<div class="dato">
<span>🧾 Créditos pagados hoy</span>
<strong id="totalPagosCredito">$0.00</strong>
</div>
<div class="dato">
<span>🔴 Crédito pendiente</span>
<strong id="totalCreditoPendiente">$0.00</strong>
</div>
<div class="dato">
<span>💸 Gastos</span>
<strong id="totalGastos">$0.00</strong>
</div>
<div class="dato">
<span>🔄 Efectivo entregado por cambios</span>
<strong id="totalCambiosTransferencia">$0.00</strong>
</div>

<p class="aviso">
🔄 Los cambios de efectivo NO son ventas y NO se suman a las
transferencias de ventas.
</p>

<div class="divider"></div>

<h3>📈 Ganancia</h3>
<div class="dato">
<span>📦 Costo de mercancía vendida</span>
<strong id="costoVendido">$0.00</strong>
</div>
<div class="dato">
<span>🧾 Ventas - costo - gastos</span>
<strong id="gananciaOperativa">$0.00</strong>
</div>
<div class="dato destacado">
<span>✅ Ganancia neta</span>
<strong id="ganancia">$0.00</strong>
</div>

<div class="divider"></div>

<h3>💵 Dinero esperado en caja</h3>

<button class="verde" onclick="ponerCajaInicial()">
💵 Registrar / cambiar dinero inicial
</button>

<div class="dato">
<span>Dinero inicial</span>
<strong id="cajaInicial">$0.00</strong>
</div>

<p class="efectivo" id="dineroCaja">$0.00</p>

<p class="aviso">
Fórmula: dinero inicial + ventas en efectivo − compras pagadas − pagos de créditos − gastos − efectivo entregado por cambios.
<br>
Las ventas por transferencia NO entran a la caja física.
</p>

<div class="divider"></div>

<button class="danger" onclick="nuevoDia()">
🌙 CERRAR DÍA / NUEVO DÍA
</button>

<p class="aviso">
⚠️ Al cerrar el día se guarda el resumen y se limpian solo
las operaciones del día.
<br><br>
<strong>📦 EL INVENTARIO QUEDA EXACTAMENTE COMO ESTÁ.</strong>
</p>

</div>

</div>


<!-- RECETAS -->

<div id="recetas" class="oculto">

<div class="card">
<h2>🍹 Recetas / Preparaciones</h2>
<p class="aviso">Guarda recetas y consulta el costo estimado por preparación usando los productos de tu inventario.</p>
<input id="nombreReceta" type="text" placeholder="Nombre de la receta">
<textarea id="ingredientesReceta" rows="5" placeholder="Ingredientes y cantidades, por ejemplo: 1 refresco + 50 ml de jarabe"></textarea>
<input id="costoReceta" type="number" min="0" step="0.01" placeholder="Costo estimado por preparación">
<button onclick="agregarReceta()">Guardar receta</button>
</div>

<div class="card">
<h2>📋 Mis recetas</h2>
<div id="listaRecetas"></div>
</div>

</div>


<!-- HISTORIAL -->

<div id="historial" class="oculto">

<div class="card">

<h2>📚 Historial de Días</h2>

<div id="listaHistorial"></div>

</div>

</div>


<script>

/* =========================================================
   BASE DE DATOS LOCAL
   ========================================================= */

/*
   IMPORTANTE:
   NO HAY NINGÚN localStorage.removeItem().
   Por eso recargar la página NO borra información.
*/

let productos =
JSON.parse(localStorage.getItem("cantina_productos_v3")) || [];

let ventas =
JSON.parse(localStorage.getItem("cantina_ventas_v3")) || [];

let compras =
JSON.parse(localStorage.getItem("cantina_compras_v3")) || [];

// Compras a crédito permanecen pendientes entre días hasta liquidarse.
let creditos =
JSON.parse(localStorage.getItem("cantina_creditos_v1")) || [];

let gastos =
JSON.parse(localStorage.getItem("cantina_gastos_v3")) || [];

let movimientos =
JSON.parse(localStorage.getItem("cantina_movimientos_v3")) || [];

let historial =
JSON.parse(localStorage.getItem("cantina_historial_v3")) || [];

let cajaInicial =
Number(localStorage.getItem("cantina_caja_v3")) || 0;

let recetas =
JSON.parse(localStorage.getItem("cantina_recetas_v1")) || [];


/* =========================================================
   GUARDAR
   ========================================================= */

function guardar(){

    localStorage.setItem(
        "cantina_productos_v3",
        JSON.stringify(productos)
    );

    localStorage.setItem(
        "cantina_ventas_v3",
        JSON.stringify(ventas)
    );

    localStorage.setItem(
        "cantina_compras_v3",
        JSON.stringify(compras)
    );

    localStorage.setItem(
        "cantina_creditos_v1",
        JSON.stringify(creditos)
    );

    localStorage.setItem(
        "cantina_gastos_v3",
        JSON.stringify(gastos)
    );

    localStorage.setItem(
        "cantina_movimientos_v3",
        JSON.stringify(movimientos)
    );

    localStorage.setItem(
        "cantina_historial_v3",
        JSON.stringify(historial)
    );

    localStorage.setItem(
        "cantina_caja_v3",
        cajaInicial
    );

    localStorage.setItem(
        "cantina_recetas_v1",
        JSON.stringify(recetas)
    );
}


/* =========================================================
   FECHA
   ========================================================= */

function fechaActual(){

    return new Date().toLocaleDateString(
        "es-MX",
        {
            day:"2-digit",
            month:"2-digit",
            year:"numeric"
        }
    );
}

document.getElementById("fecha").textContent =
fechaActual();


/* =========================================================
   PESTAÑAS
   ========================================================= */

function mostrar(nombre,boton){

    [
        "productos",
        "compras",
        "ventas",
        "gastos",
        "movimientos",
        "resumen",
        "historial",
        "recetas"
    ].forEach(id=>{
        document.getElementById(id)
        .classList.add("oculto");
    });

    document.querySelectorAll(".tab")
    .forEach(t=>t.classList.remove("active"));

    document.getElementById(nombre)
    .classList.remove("oculto");

    boton.classList.add("active");

    actualizar();
}


/* =========================================================
   AGREGAR PRODUCTO
   ========================================================= */

function agregarProducto(){

    const nombre =
    document.getElementById("nombre").value.trim();

    const costo =
    Number(document.getElementById("costo").value);

    const precio =
    Number(document.getElementById("precio").value);

    const stock =
    Number(document.getElementById("stock").value) || 0;


    if(
        !nombre ||
        isNaN(costo) ||
        isNaN(precio) ||
        costo<0 ||
        precio<0 ||
        stock<0
    ){

        alert("Completa correctamente todos los datos.");
        return;
    }


    productos.push({

        id:Date.now(),

        nombre:nombre,

        costo:costo,

        precio:precio,

        stock:stock

    });


    guardar();
    actualizar();


    document.getElementById("nombre").value="";
    document.getElementById("costo").value="";
    document.getElementById("precio").value="";
    document.getElementById("stock").value="";


    alert("✅ Producto agregado.");
}


/* =========================================================
   COMPRA
   ========================================================= */

function actualizarCamposCompra(){

    const tipo=document.getElementById("tipoCompra").value;
    document.getElementById("compraUnidadCampos")
        .classList.toggle("oculto",tipo!=="unidad");
    document.getElementById("compraCajaCampos")
        .classList.toggle("oculto",tipo!=="caja");

    actualizarDetalleCompra();
}

function actualizarDetalleCompra(){

    const tipo=document.getElementById("tipoCompra").value;
    const detalle=document.getElementById("detalleCompra");

    if(tipo==="unidad"){
        const cantidad=Number(document.getElementById("cantidadCompra").value)||0;
        const costo=Number(document.getElementById("costoCompraUnidad").value);
        detalle.textContent = cantidad>0 && costo>=0 && isFinite(costo)
            ? `Total compra: $${(cantidad*costo).toFixed(2)} · ${cantidad} unidad(es)`
            : "Puedes dejar el costo vacío para usar el costo actual del producto.";
    }else{
        const cajas=Number(document.getElementById("cantidadCajas").value)||0;
        const unidades=Number(document.getElementById("unidadesPorCaja").value)||0;
        const costoCaja=Number(document.getElementById("costoCaja").value);
        if(cajas>0 && unidades>0 && costoCaja>=0 && isFinite(costoCaja)){
            const totalUnidades=cajas*unidades;
            const costoUnidad=costoCaja/unidades;
            detalle.textContent=`Recibirás ${totalUnidades} unidades · Costo por unidad: $${costoUnidad.toFixed(2)} · Total: $${(cajas*costoCaja).toFixed(2)}`;
        }else{
            detalle.textContent="Ejemplo: 1 caja × 12 unidades × $420 = 12 unidades a $35 de costo c/u.";
        }
    }
}

function registrarCompra(){

    const id=Number(document.getElementById("productoCompra").value);
    const tipo=document.getElementById("tipoCompra").value;

    if(!id){
        alert("Selecciona un producto.");
        return;
    }

    const producto=productos.find(p=>p.id===id);
    if(!producto){
        alert("Producto no encontrado.");
        return;
    }

    let cantidadUnidades=0;
    let costoUnitario=Number(producto.costo)||0;
    let total=0;
    let detalleCompra="";

    if(tipo==="caja"){
        const cajas=Number(document.getElementById("cantidadCajas").value);
        const unidadesPorCaja=Number(document.getElementById("unidadesPorCaja").value);
        const costoCaja=Number(document.getElementById("costoCaja").value);

        if(!cajas || cajas<=0 || !unidadesPorCaja || unidadesPorCaja<=0 ||
           !isFinite(costoCaja) || costoCaja<0){
            alert("Completa correctamente cajas, unidades por caja y costo de la caja.");
            return;
        }

        cantidadUnidades=cajas*unidadesPorCaja;
        costoUnitario=costoCaja/unidadesPorCaja;
        total=cajas*costoCaja;
        detalleCompra=`${cajas} caja(s) × ${unidadesPorCaja} unidades`;

    }else{
        const cantidad=Number(document.getElementById("cantidadCompra").value);
        const costoInput=document.getElementById("costoCompraUnidad").value.trim();

        if(!cantidad || cantidad<=0){
            alert("Ingresa una cantidad de unidades.");
            return;
        }

        if(costoInput!==""){
            costoUnitario=Number(costoInput);
            if(!isFinite(costoUnitario) || costoUnitario<0){
                alert("El costo por unidad no es válido.");
                return;
            }
        }

        cantidadUnidades=cantidad;
        total=cantidadUnidades*costoUnitario;
        detalleCompra=`${cantidadUnidades} unidad(es)`;
    }

    const estado = document.getElementById("estadoCompra").value;
    const proveedor = document.getElementById("proveedorCompra").value.trim() || "Proveedor no indicado";

    /* Las compras a crédito entran al inventario, pero NO salen de caja.
       Se guardan aparte para poder pagarlas después, incluso tras un cierre. */
    if(estado === "credito") {
        creditos.unshift({
            id: Date.now(),
            productoId: producto.id,
            nombre: producto.nombre,
            proveedor: proveedor,
            cantidad: cantidadUnidades,
            tipoCompra: tipo,
            detalleCompra: detalleCompra,
            costo: costoUnitario,
            total: total,
            saldo: total,
            fecha: fechaActual(),
            pagos: []
        });
    } else {
        compras.unshift({
            id: Date.now(),
            productoId: producto.id,
            nombre: producto.nombre,
            cantidad: cantidadUnidades,
            tipoCompra: tipo,
            detalleCompra: detalleCompra,
            costo: costoUnitario,
            total: total,
            fecha: fechaActual(),
            pagada: true
        });
    }

    producto.stock += cantidadUnidades;

    /* El costo queda expresado SIEMPRE por unidad.
       Esto permite vender una unidad aunque la compra haya sido por caja. */
    producto.costo=costoUnitario;

    guardar();
    actualizar();

    document.getElementById("cantidadCompra").value="";
    document.getElementById("costoCompraUnidad").value="";
    document.getElementById("cantidadCajas").value="";
    document.getElementById("unidadesPorCaja").value="";
    document.getElementById("costoCaja").value="";
    document.getElementById("proveedorCompra").value="";
    document.getElementById("estadoCompra").value="pagada";
    actualizarDetalleCompra();

    alert(
        "✅ Compra registrada.\n\n"+
        producto.nombre+
        "\nEntrada al inventario: "+cantidadUnidades+" unidades"+
        "\nCosto por unidad: $"+costoUnitario.toFixed(2)+
        "\nInventario actual: "+producto.stock
    );
}

/* =========================================================
   CRÉDITOS / CUENTAS POR PAGAR
   ========================================================= */

function totalPagosCreditoHoy(){
    return creditos.reduce((s,c)=>s + (c.pagos || []).filter(p=>p.fecha===fechaActual()).reduce((a,p)=>a+Number(p.monto||0),0),0);
}

function pagarCredito(id){
    const credito = creditos.find(c=>c.id===id);
    if(!credito || credito.saldo <= 0) return;

    const montoInput = prompt(
        "Pago a " + credito.proveedor + "\n" + credito.nombre + "\n\nSaldo pendiente: $" + Number(credito.saldo).toFixed(2) + "\n\nEscribe cuánto vas a pagar:",
        Number(credito.saldo).toFixed(2)
    );
    if(montoInput===null) return;

    const monto=Number(montoInput);
    if(!isFinite(monto) || monto<=0 || monto>credito.saldo){
        alert("El monto no es válido. No puede ser mayor al saldo pendiente.");
        return;
    }

    credito.saldo = Math.max(0, Number(credito.saldo)-monto);
    credito.pagos = credito.pagos || [];
    credito.pagos.unshift({id:Date.now(), monto:monto, fecha:fechaActual(), hora:new Date().toLocaleTimeString("es-MX")});

    guardar();
    actualizar();

    alert("✅ Pago registrado.\n\nSe descontaron $"+monto.toFixed(2)+" de caja."+(credito.saldo===0 ? "\nLa deuda quedó liquidada." : "\nSaldo restante: $"+credito.saldo.toFixed(2)));
}

function eliminarCredito(id){
    const credito=creditos.find(c=>c.id===id);
    if(!credito) return;
    if((credito.pagos||[]).length>0){
        alert("No puedes eliminar una deuda que ya tiene pagos registrados.");
        return;
    }
    if(!confirm("¿Eliminar esta compra a crédito? El inventario NO se revertirá.")) return;
    creditos=creditos.filter(c=>c.id!==id);
    guardar(); actualizar();
}

/* =========================================================
   VENTA
   ========================================================= */

function registrarVenta(){

    const id =
    Number(document.getElementById("productoVenta").value);

    const cantidad =
    Number(document.getElementById("cantidadVenta").value);


    if(
        !id ||
        !cantidad ||
        cantidad<=0
    ){

        alert("Selecciona un producto y una cantidad.");
        return;
    }


    const producto =
    productos.find(p=>p.id===id);


    if(!producto){

        alert("Producto no encontrado.");
        return;
    }


    if(producto.stock < cantidad){

        alert(
            "❌ NO HAY SUFICIENTE INVENTARIO.\n\n"+
            producto.nombre+
            "\nDisponible: "+
            producto.stock+
            "\nSolicitado: "+
            cantidad
        );

        return;
    }


    /*
       AQUÍ SE DESCUENTA EL INVENTARIO.

       ESTE STOCK QUEDA GUARDADO.

       EL BOTÓN NUEVO DÍA JAMÁS TOCA ESTE VALOR.
    */

    producto.stock =
    producto.stock - cantidad;


    ventas.unshift({

        id:Date.now(),

        productoId:producto.id,

        nombre:producto.nombre,

        cantidad:cantidad,

        precio:producto.precio,

        costo:producto.costo,

        total:cantidad*producto.precio,

        metodoPago: document.getElementById("metodoVenta").value,

        costoTotal:cantidad*producto.costo,

        fecha:fechaActual(),

        hora:new Date().toLocaleTimeString("es-MX")

    });


    guardar();
    actualizar();


    document.getElementById("cantidadVenta").value="";


    alert(
        "✅ Venta registrada.\n\n"+
        producto.nombre+
        "\nVendidas: "+
        cantidad+
        "\nInventario restante: "+
        producto.stock
    );
}


/* =========================================================
   ELIMINAR VENTA
   ========================================================= */

function eliminarVenta(id){

    const venta =
    ventas.find(v=>v.id===id);


    if(!venta)return;


    if(!confirm(
        "¿Eliminar esta venta?\n\n"+
        "La cantidad vendida volverá al inventario."
    ))return;


    const producto =
    productos.find(
        p=>p.id===venta.productoId
    );


    /*
       SOLO AL DESHACER UNA VENTA
       SE DEVUELVE EL PRODUCTO.
    */

    if(producto){

        producto.stock += venta.cantidad;

    }


    ventas =
    ventas.filter(v=>v.id!==id);


    guardar();
    actualizar();
}


